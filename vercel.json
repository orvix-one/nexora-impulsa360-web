{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["gru1"],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js?__api_path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?!api(?:/|$))(?!.*\\.[^/]+$)(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/archivar-fotos",
      "schedule": "0 7 * * *"
    }
  ]
}
