# Frontend (Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_ADMIN_API_URL=/api
VITE_STORAGE_BUCKET_ACTIVACIONES=fotos-activaciones

# Backend API admin
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_API_PORT=8787
ADMIN_API_CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://*.vercel.app
ADMIN_STORAGE_BUCKET_ACTIVACIONES=fotos-activaciones
ADMIN_STORAGE_LIMIT_MB=1024
ADMIN_DATABASE_LIMIT_MB=500
EVIDENCE_LINK_SECRET=
EVIDENCE_PUBLIC_BASE_URL=https://tu-dominio.com/api

# Prod Session pooler URL (.env is local and .env.dev. for dev)
DB_URL=

# Cloudflare R2: one token with access to impulsa360-fotos and impulsa360-respaldos (bucket names are constants in server/r2.js). R2_ACCOUNT_ID accepts the hex id or the full S3 endpoint URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_UPLOADS_ENABLED=true
FOTOS_RETENCION_SUPABASE_DIAS=2
CRON_SECRET=
